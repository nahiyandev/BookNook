# BookNook env — MERGED version (replaces the Section 2 .env.example).
# COPY this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER paste these values in chat.
# The same variables must also be set in Vercel (Project → Settings →
# Environment Variables), then redeploy — env changes need a new deployment.

# --- Public (browser-safe, NEXT_PUBLIC_ prefix is REQUIRED) ---
# Backend API base URL. This is a public address, not a secret.
# Live backend (already deployed): https://book-nook-servar.vercel.app
# Locally, change this ONE line in .env.local to your local backend URL,
# e.g. http://localhost:5000 — do NOT change any code file.

NEXT_PUBLIC_API_URL=https://book-nook-servar.vercel.app

# --- Server-only (NEVER add NEXT_PUBLIC_ to these) ---
MONGO_URI=
MONGODB_DB=booknook
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
